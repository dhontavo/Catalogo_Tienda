# ─── Configuración de la API ─────────────────────────────────
# API Key requerida en el header X-API-Key para acceder a todos los endpoints.
# Genera una nueva con: openssl rand -base64 32
API_KEY=tu_api_key_aqui

# ─── JWT ─────────────────────────────────────────────────────
# Secreto para firmar los tokens JWT. Cámbialo en producción.
JWT_SECRET=tu_jwt_secret_aqui

# ─── Base de datos ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=catalogo_tienda
DB_USER=root
DB_PASS=

# ─── Stripe Payments & Subscriptions ─────────────────────────
# Claves de prueba (Test Mode) o producción de Stripe
# Obtén tus claves en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta_aqui
STRIPE_PUBLISHABLE_KEY=pk_test_tu_clave_publicable_aqui
STRIPE_WEBHOOK_SECRET=whsec_tu_secreto_webhook_aqui
STRIPE_CURRENCY=mxn

